# Copy this file to .env.local and fill in the values below.
# .env.local is already git-ignored — never commit real secrets.

# --- Supabase -----------------------------------------------------------
# Supabase dashboard → your project → Project Settings → API
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key (NOT the anon key)
#
# This key is only ever read on the server (lib/supabase/server.ts). It is
# never sent to the browser and never goes into ESP32 firmware.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- ESP32 device authentication -----------------------------------------
# A shared secret the Next.js API checks on every /api/hive-data request,
# sent by the ESP32 as: Authorization: Bearer <this value>
# Generate any long random string, e.g.: openssl rand -hex 32
HIVE_DEVICE_API_KEY=

# --- App URL (used to build QR code links) -------------------------------
# Your deployed domain in production, or http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Default beekeeper (no login system yet) -----------------------------
# There is no auth yet, so the app operates as a single beekeeper account,
# auto-created the first time any page loads. Set these before first run,
# or edit them later from /beekeeper/profile.
DEFAULT_BEEKEEPER_CODE=BK-0001
DEFAULT_BEEKEEPER_NAME=Beekeeper
DEFAULT_BEEKEEPER_EMAIL=beekeeper@honeychain.demo
DEFAULT_BEEKEEPER_REGION=Unknown Region
