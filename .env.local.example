# Copy this file to .env.local and fill in the values below.
# .env.local is already git-ignored — never commit real secrets.

# --- Supabase -----------------------------------------------------------
# Supabase dashboard → your project → Project Settings → API
#   SUPABASE_URL              = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key (NOT the anon key)
#
# This key is only ever read on the server (lib/supabase/server.ts). It is
# never sent to the browser and never goes into ESP32 firmware.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Beekeeper login sessions ---------------------------------------------
# Signs the session cookie issued at /login and /signup (a JWT). Generate
# any long random string, e.g.: openssl rand -hex 32
# Changing this instantly logs every beekeeper out. Keep it secret.
SESSION_SECRET=

# --- App URL (used to build QR code links) -------------------------------
# Your deployed domain in production, or http://localhost:3000 locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Note: there is no shared ESP32 device key anymore. Each hive gets its
# own device secret, generated and shown once when you register it from
# /beekeeper/hives/new — see README.md.

# --- AI hive health prediction (OpenRouter) -------------------------------
# Powers the "AI Hive Prediction" card on a hive's detail page — an
# on-demand (not automatic) call, through OpenRouter's unified API, that
# reads recent sensor history and predicts colony health. Get a key from
# https://openrouter.ai/keys. Without this set, the card shows a clear
# error instead of crashing the page.
OPENROUTER_API_KEY=

# Optional: which model to use (defaults to "openrouter/free" in code —
# OpenRouter's auto-router, which always resolves to a currently-available
# free model at $0 cost). Point this at a specific model once you have
# OpenRouter credits, e.g.:
#   OPENROUTER_MODEL=x-ai/grok-4-fast
# See https://openrouter.ai/models for the full catalog and current pricing.
# OPENROUTER_MODEL=openrouter/free

# Optional: override the model for the camera photo "Visual Screening"
# feature — must support image input. Defaults to "openrouter/free" in
# code, same as above; that auto-router detects the image in the request
# and picks a vision-capable free model on its own. Only set this if you
# want a specific model instead, e.g. once you have OpenRouter credits:
#   OPENROUTER_VISION_MODEL=x-ai/grok-4-fast
# OPENROUTER_VISION_MODEL=openrouter/free
